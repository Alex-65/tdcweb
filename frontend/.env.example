# Flask backend URL used by Nuxt SSR (server-to-server, bypasses nginx).
NUXT_FLASK_URL=http://localhost:9502

# Cookie signing secret (H3 cookie module). Generate with: openssl rand -hex 64
NUXT_COOKIE_SECRET=change-me-in-production

# Public site URL used for canonical links, Open Graph, sitemap, etc.
NUXT_PUBLIC_SITE_URL=http://localhost:9503

# API base path as seen by the browser (relative — resolved by nginx in prod, by Nitro devProxy in dev).
NUXT_PUBLIC_API_BASE=/api
